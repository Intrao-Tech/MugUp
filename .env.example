# ----- Data backend -------------------------------------------------------
# Which DataBackend implementation to use (src/lib/data). Only "supabase"
# exists today; a future backend (postgres+s3+authjs, ...) is selected here.
DATA_BACKEND=supabase

# ----- Supabase (Settings -> API in the dashboard) ------------------------
# Without these the public site still runs; forms are disabled and the admin
# panel shows a setup page.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. NEVER expose this key to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ----- Email notifications for new enquiries (optional) --------------------
# Without these, submissions still work — the email step is simply skipped.
# Create a free API key at resend.com; verify the sender domain for prod.
#RESEND_API_KEY=re_YOUR-KEY
#LEADS_NOTIFY_EMAIL=hello@mugupstudio.com
#LEADS_NOTIFY_FROM=MugUp Website <website@mugupstudio.com>

# ----- Host binding --------------------------------------------------------
# The public site answers ONLY on this host; any other host is a hard 404.
# Leave unset on Vercel if you need *.vercel.app preview deployments to work.
#PUBLIC_HOST=mugupstudio.com

# ----- Admin panel isolation ----------------------------------------------
# Host that serves the admin panel (a non-advertised subdomain, e.g.
# ops-x7k2.mugupstudio.com). On every other host /admin is a hard 404.
# UNSET: /admin works in local development only; in production the admin
# panel is fail-closed (404 everywhere) until this is set.
#ADMIN_HOST=ops-x7k2.mugupstudio.com

# Optional extra gate: comma-separated IPv4s/CIDRs allowed to reach the admin
# host (VPN egress / office IPs). Unknown or unlisted IPs get a 404.
# Do not set this in local development.
#ADMIN_IP_ALLOWLIST=203.0.113.7,10.8.0.0/24
