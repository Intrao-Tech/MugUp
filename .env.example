# ----- Data backend -------------------------------------------------------
# Which DataBackend implementation to use (src/lib/data). Only "supabase"
# exists today; a future backend (postgres+s3+authjs, ...) is selected here.
DATA_BACKEND=supabase

# ----- Supabase (Settings -> API in the dashboard) ------------------------
# Without these the public site still runs; forms are disabled and the admin
# panel shows a setup page.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. NEVER expose this key to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional, server-only: Postgres connection string (dashboard -> Connect ->
# Session pooler URI, password percent-encoded). When set, a PRODUCTION build
# applies pending supabase/migrations before `next build`
# (scripts/deploy-migrate.mjs; docs/DEPLOY.md "Migrations on deploy").
# SUPABASE_DB_URL=postgresql://...
# Forces the migration step outside VERCEL_ENV=production (e.g. local tests).
# MIGRATE_ON_DEPLOY=true

# ----- Outgoing email (optional) -------------------------------------------
# Full setup guide: docs/EMAIL-SETUP.md. ONE channel for everything the app
# sends: team invites, password resets and the email copies of new
# enquiries/reviews. Pick a transport:
#   SMTP (any host; Gmail app-password works for testing):
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASS=your-app-password
#   or Resend HTTP API (production: verify the domain first):
#RESEND_API_KEY=re_YOUR-KEY
# Sender shown on every email (must be on the verified domain for Resend):
#MAIL_FROM=Mug.Up Studio <noreply@mugupstudio.com>
# Inbox that receives the email copies of new enquiries/reviews:
#LEADS_NOTIFY_EMAIL=hello@mugupstudio.com
# Without any of these: in-admin notifications still work; invites fall back
# to Supabase Auth email (= Mailpit on the local stack).

# ----- Host binding --------------------------------------------------------
# The public site answers ONLY on this host; any other host is a hard 404.
# Leave unset on Vercel if you need *.vercel.app preview deployments to work.
#PUBLIC_HOST=mugupstudio.com

# ----- Admin panel isolation ----------------------------------------------
# Host that serves the admin panel (a non-advertised subdomain, e.g.
# ops-x7k2.mugupstudio.com). On every other host /admin is a hard 404.
# UNSET: /admin works in local development only; in production the admin
# panel is fail-closed (404 everywhere) until this is set.
#ADMIN_HOST=ops-x7k2.mugupstudio.com

# Optional extra gate: comma-separated IPv4s/CIDRs allowed to reach the admin
# host (VPN egress / office IPs). Unknown or unlisted IPs get a 404.
# Do not set this in local development.
#ADMIN_IP_ALLOWLIST=203.0.113.7,10.8.0.0/24
