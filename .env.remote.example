# Seeding a HOSTED Supabase project (npm run seed:remote).
# Copy to .env.remote (gitignored) and fill in. Values come from
# Supabase dashboard -> Settings -> API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Explicit opt-in: without this the seed refuses any non-local URL.
SEED_ALLOW_REMOTE=1

# The administrator to create (own email + password). Without these the
# script would seed the @mugup.local demo trio with the password admin123 —
# never do that on a hosted project.
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=ChooseAStrongOne1
SEED_ADMIN_NAME=Your Name

# 1 = also insert demo enquiries/reviews/posts (useful on a test project),
# 0 = create the administrator only.
SEED_DEMO_DATA=1

# --- Seeding straight from a deployment (no local run needed) ---
# In the HOSTING env (Vercel -> Settings -> Environment Variables) ONE
# variable is enough — the rest fall back to defaults and the generated
# admin password is printed in the build log. Delete it after the deploy.
# SEED_ON_DEPLOY=true

# --- Schema on deploy (hosting env only) ---
# With this set, every build applies pending supabase/migrations before
# building. Use the SESSION POOLER string (dashboard -> Connect -> Session
# pooler, port 5432): the direct db.<ref>.supabase.co host is IPv6-only and
# CI builders are IPv4-only. Port 6543 (transaction pooler) will NOT do.
# SUPABASE_DB_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
